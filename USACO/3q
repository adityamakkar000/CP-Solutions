int get_score(string a){ 
    
    int ans = 0; 
    int n = a.size();
    for(int i = 0; i < n-1; i++){ 
        if(a[i] == '1' && a[i+1] == '0'){ 
            ans++; 
        } 
        else if(a[i] == '0' && a[i+1] == '1'){ 

            ans--; 
        } 
    } 

    return ans; 
} 


int calculate_score(int node,vector<int> v[], vector<char> &w,vector<bool> &visited, string &current){
   int score = 0; 

    if(visited[node]){ 
        return 0;
    } 

    visited[node] = true; 
    current += w[node]; 
    
    if(node != 0 && v[node].size() == 1){ 
        score += get_score(current); 
        return score; 
    } 


    for(int i: v[node]){ 
        if(!visited[node]){ 
            score += calculate_score(v, w, visited, current); 
        } 
    } 

    return score;

} 



void solve(){ 
    
    int n; cin >> n; 

    vector<int> v[n]; 
    vector<char> w(n); 
    for(int i = 0; i < n-1; i++){ 
        int a,b; cin >> a >> b; 
        a--; b--; 
        v[a].push_back(b); 
        v[b].push_back(a); 
    } 

    string a; 
    cin >> a; 
    int count = 0;  
    for(int i = 0; i < n; i++){ 
        if(a[i] != '?'){ 
           w[i] = a[i];
        } 
        else{ 
           w[i] = count % 2 == 0 ? '0' : '1'; 
        } 
    } 
    vector<bool> visited(n,false); 
    string current = "";     
    int ans = calculate_score(v, w, visited, current); 
    cout << ans << endl; 


} 
int32_t main(){

  int t; cin >> t;
  while(t--){
    solve();
  }



